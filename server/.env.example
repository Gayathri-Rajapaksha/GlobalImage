# Server Port
PORT=5050

# Client Application URL (for CORS configuration, comma-separated if multiple)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
MONGO_URI=mongodb://localhost:27017/globalimage

# JWT Secret Key (required, generate a strong random string: e.g., openssl rand -base64 32)
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long

# Cloudinary Storage Configuration (Optional - falls back to local disk storage if not configured)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer for Gmail or custom SMTP - optional, simulates if not provided)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Initial Admin Bootstrap (Optional: used by npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@global.com
INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password
